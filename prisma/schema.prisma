// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String?
  classId           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lessonProgress    LessonProgress[]
  studentMilestones StudentMilestone[]
  userLevel         UserLevel?
  xpTransactions    XPTransaction[]
  streakLogs        StreakLog[]
  userBadges        UserBadge[]
}

model Subject {
  id          String      @id @default(cuid())
  name        String
  description String?
  code        String      @unique
  modules     Module[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Module {
  id          String    @id @default(cuid())
  name        String
  description String?
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  order       Int
  lessons     Lesson[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([subjectId, order])
}

model Lesson {
  id                String               @id @default(cuid())
  title             String
  description       String?
  moduleId          String
  module            Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order             Int
  content           String
  videoUrl          String?
  duration          Int?
  interactiveComponents InteractiveComponent[]
  mediaAssets       MediaAsset[]
  lessonProgress    LessonProgress[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([moduleId, order])
}

model InteractiveComponent {
  id        String   @id @default(cuid())
  type      String   // "quiz", "reflection_prompt", "discussion"
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  prompt    String
  options   String?  // JSON string for quiz options
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, order])
}

model MediaAsset {
  id        String   @id @default(cuid())
  type      String   // "video", "image", "document", "audio"
  url       String
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String?
  metadata  String?  // JSON metadata (e.g., duration, dimensions)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, order])
}

model MasteryMilestone {
  id                String              @id @default(cuid())
  name              String
  description       String?
  threshold         Int                 // percentage required to achieve milestone
  studentMilestones StudentMilestone[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model StudentMilestone {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   MasteryMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  achievedAt  DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, milestoneId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  progress  Int      @default(0)  // percentage
  startedAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model UserLevel {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int      @default(1)
  totalXP   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  metadata  String?  // JSON metadata (e.g., lessonId, quizScore)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model StreakLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  loggedIn  Boolean  @default(true)
  streakCount Int    @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  category    String      // "streak", "completion", "performance", "mastery"
  criteria    String      // JSON criteria for earning the badge
  iconUrl     String?
  rarity      String      @default("common") // "common", "rare", "epic", "legendary"
  xpReward    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]

  @@unique([name, category])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Level {
  id          String   @id @default(cuid())
  level       Int      @unique
  requiredXP  Int
  title       String
  description String?
  rewards     String?  // JSON rewards (e.g., badges, features)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
